---
import { t, getLinks, type Lang } from '../i18n';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const i = t(lang);
const links = getLinks(lang);
const isRtl = lang === 'fa';
---

<section class="hero" dir={isRtl ? 'rtl' : 'ltr'}>
  <div class="container hero-inner">
    <div class="hero-content">
      <div class="badge">{i.hero.badge}</div>
      <h1>{i.hero.titleStart} <span class="gradient-text">{i.hero.titleHighlight}</span></h1>
      <p class="hero-description">{i.hero.description}</p>
      <div class="hero-buttons">
        <a href={links.bot} target="_blank" rel="noopener noreferrer" class="btn-primary">{i.hero.cta}</a>
        <a href={links.learn} target="_blank" class="btn-secondary">{i.hero.ctaSecondary}</a>
      </div>
    </div>
    <div class="hero-visual">
      <video autoplay loop muted playsinline class="hero-video" poster="/img/logo.png">
        <source src="/img/hero-animation.m4v" type="video/mp4" />
      </video>
    </div>
  </div>
</section>

<style>
  .hero { padding: 8rem 0 4rem; min-height: 90vh; display: flex; align-items: center; }
  .hero-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
  .badge {
    display: inline-block; background: rgba(0,180,216,0.1); border: 1px solid var(--border);
    border-radius: 50px; padding: 0.4rem 1.2rem; font-size: 0.85rem; color: var(--accent);
    font-weight: 500; margin-bottom: 1.5rem;
  }
  h1 { font-size: 3.8rem; font-weight: 800; line-height: 1.1; margin-bottom: 1.5rem; }
  .gradient-text {
    background: linear-gradient(135deg, var(--accent), var(--accent-light), var(--lightning));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .hero-description { color: var(--text-secondary); font-size: 1.2rem; line-height: 1.7; margin-bottom: 2rem; max-width: 520px; }
  .hero-buttons { display: flex; gap: 1rem; flex-wrap: wrap; }
  .hero-visual { display: flex; justify-content: center; align-items: center; }
  .hero-video { max-width: 100%; max-height: 480px; border-radius: var(--radius-lg); filter: drop-shadow(0 0 40px var(--accent-glow)); }

  @media (max-width: 768px) {
    .hero { padding: 6rem 0 2rem; min-height: auto; }
    .hero-inner { grid-template-columns: 1fr; gap: 2rem; text-align: center; }
    h1 { font-size: 2.5rem; }
    .hero-description { margin: 0 auto 2rem; }
    .hero-buttons { justify-content: center; }
    .hero-visual { order: -1; }
    .hero-video { max-height: 300px; }
  }
</style>
